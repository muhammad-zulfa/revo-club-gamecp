generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Race {
  BELLATO
  CORA
  ACCRETIA
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  TRIAL
}

enum UserRole {
  ADMIN
  MEMBER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventCategory {
  PIT_BOSS
  CHIP_WAR
  GVG
  OTHER
}

enum EventAttendanceStatus {
  IN_VOICE
  LEFT
  PRESENT
}

enum WarehouseItemSource {
  PIT_BOSS
  GUILD_SELLER
}

enum WarehouseItemStatus {
  STORED
  LISTED
  SOLD_EXTERNALLY
  SOLD_TO_MEMBER
  CANCELLED
}

enum CurrencyUnit {
  GP
  CASH_COIN
  IDR
}

enum GpLedgerEntryType {
  TRANSFER_SENT
  TRANSFER_RECEIVED
  WAREHOUSE_PURCHASE
  ADMIN_ADJUSTMENT
  EVENT_BONUS
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String
  passwordHash   String
  role           UserRole       @default(MEMBER)
  approvalStatus ApprovalStatus @default(PENDING)
  discordHandle  String         @unique
  discordId      String?        @unique
  joinedDiscord  Boolean        @default(false)
  profileCompleted Boolean      @default(false)
  gpBalance      Float          @default(0)
  approvedAt     DateTime?
  events         Event[]
  attendances    EventAttendance[]
  warehouseItems WarehouseItem[]
  guildMember    GuildMember?
  gpLedgerEntries GpLedgerEntry[] @relation("GpLedgerOwner")
  gpRelatedEntries GpLedgerEntry[] @relation("GpLedgerRelatedUser")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model AppConfig {
  id                       String   @id @default("default")
  appBaseUrl               String?
  discordServerName        String?
  discordInviteUrl         String?
  discordRegistrationLabel String?
  discordRegistrationChannelId String?
  discordEventChannelId    String?
  discordGuildTradeChannelId String?
  discordPitBossChannelId  String?
  discordChipWarChannelId  String?
  discordGvgChannelId      String?
  discordOtherChannelId    String?
  discordMemberRoleId      String?
  discordEventReminderOffsets String?
  discordEventAttendanceMinutes String?
  discordApprovalWebhookUrl String?
  discordInteractionsPublicKey String?
  discordAdminRoleId       String?
  discordAdminUserIds      String?
  discordBotToken          String?
  discordOAuthClientId     String?
  discordOAuthClientSecret String?
  discordGuildId           String?
  guildGpBalance           Float    @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Guild {
  id          String        @id @default(cuid())
  name        String
  worldName   String
  race        Race
  description String?
  members     GuildMember[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model GuildMember {
  id         String       @id @default(cuid())
  nickname   String
  level      Int          @default(1)
  className  String
  race       Race
  role       String       @default("Member")
  status     MemberStatus @default(ACTIVE)
  isOnline   Boolean      @default(false)
  lastSeenAt DateTime?
  joinedAt   DateTime     @default(now())
  userId     String?      @unique
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  guildId    String
  guild      Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, isOnline])
  @@unique([guildId, nickname])
}

model ActivityLog {
  id        String   @id @default(cuid())
  type      String
  title     String
  detail    String?
  createdAt DateTime @default(now())
}

model Event {
  id          String        @id @default(cuid())
  title       String
  description String?
  category    EventCategory @default(OTHER)
  startAt     DateTime
  endAt       DateTime
  discordVoiceChannelId String?
  discordReminderSentAt DateTime?
  bonusDistributedAt DateTime?
  bonusParticipantCount Int?
  bonusTotalGp Float?
  bonusGuildShareGp Float?
  bonusPerParticipantGp Float?
  reminders   EventReminder[]
  attendees   EventAttendance[]
  warehouseItems WarehouseItem[]
  gpLedgerEntries GpLedgerEntry[]
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([startAt])
  @@index([category, startAt])
}

model EventReminder {
  id                 String   @id @default(cuid())
  eventId            String
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  minutesOffset      Int
  scheduledAt        DateTime
  sentAt             DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([scheduledAt, sentAt])
  @@unique([eventId, minutesOffset])
}

model EventAttendance {
  id                   String                @id @default(cuid())
  eventId              String
  event                Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  discordId            String
  discordHandle        String?
  status               EventAttendanceStatus @default(IN_VOICE)
  currentVoiceChannelId String?
  firstJoinedAt        DateTime
  lastJoinedAt         DateTime?
  lastLeftAt           DateTime?
  qualifiedAt          DateTime?
  confirmedAt          DateTime?
  dmSentAt             DateTime?
  proofNote            String?
  proofSubmittedAt     DateTime?
  totalSecondsInVoice  Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([eventId, status])
  @@index([discordId])
  @@index([lastJoinedAt])
  @@index([qualifiedAt])
  @@unique([eventId, discordId])
}

model WarehouseItem {
  id                String              @id @default(cuid())
  name              String
  imageUrl          String
  askingPrice       Float
  askingPriceCurrency CurrencyUnit      @default(GP)
  source            WarehouseItemSource
  status            WarehouseItemStatus @default(STORED)
  notes             String?
  sellerName        String?
  soldTo            String?
  soldAmount        Float?
  soldCurrency      CurrencyUnit?
  creditedAmount    Float?
  creditedCurrency  CurrencyUnit?
  soldAt            DateTime?
  creditedAt        DateTime?
  eventId           String?
  event             Event?              @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  gpLedgerEntries   GpLedgerEntry[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, source])
  @@index([eventId])
  @@index([soldAt])
  @@index([creditedAt])
}

model GpLedgerEntry {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation("GpLedgerOwner", fields: [userId], references: [id], onDelete: Cascade)
  type           GpLedgerEntryType
  amount         Float
  note           String?
  relatedUserId  String?
  relatedUser    User?             @relation("GpLedgerRelatedUser", fields: [relatedUserId], references: [id], onDelete: SetNull)
  eventId        String?
  event          Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  warehouseItemId String?
  warehouseItem  WarehouseItem?    @relation(fields: [warehouseItemId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([relatedUserId])
  @@index([eventId])
  @@index([warehouseItemId])
}
