{
  "name": "rf-guild-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "node -e \"const fs=require('fs'); const cp=require('child_process'); if (fs.existsSync('prisma/schema.prisma')) { cp.execSync('npx prisma generate --schema=prisma/schema.prisma', { stdio: 'inherit', shell: true }); } else { console.log('Skipping prisma generate during install because prisma/schema.prisma is not available yet.'); }\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "discord:attendance-bot": "tsx scripts/discord-attendance-bot.ts",
    "events:repair-times": "tsx scripts/repair-event-times.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-popover": "^1.1.23",
    "@types/ws": "^8.18.1",
    "@vercel/blob": "^2.8.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.0.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.0.2",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
